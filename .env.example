# Copy to .env and fill in. Never commit .env.

# ── Option A: local Postgres ────────────────────────────────────────────────
# DATABASE_URL="postgresql://USER@localhost:5432/nextround"
# DIRECT_URL="postgresql://USER@localhost:5432/nextround"

# ── Option B: Supabase ──────────────────────────────────────────────────────
# Supabase dashboard → your project → Connect → ORMs → Prisma. Copy both strings.
# Replace [YOUR-PASSWORD] with your database password. If it contains spaces or
# symbols, URL-encode it (space → %20, @ → %40, # → %23, / → %2F, : → %3A).
#
# Runtime, long-running server (next dev / next start / a VPS): session pooler, port 5432.
# In testing this was ~4x faster per query than the transaction pooler. Keep connection_limit
# small so Prisma's pool fits inside Supabase's session pool. connect_timeout=15 because opening a
# connection to a far-away region can take longer than Prisma's 5-second default.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connection_limit=5&connect_timeout=15"
# Runtime, serverless (e.g. Vercel): use the transaction pooler instead, port 6543:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: session pooler / direct connection (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=15"

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Comma-separated email domains allowed to self-register as students.
STUDENT_EMAIL_DOMAINS="college.edu,gehu.ac.in"
